// standard path for graphql (Node)
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  schemas         = ["public"]
}

// standard path for graphql (Node)
generator typegraphql {
  provider        = "typegraphql-prisma"
  previewFeatures = ["multiSchema"]
  schemas         = ["public"]
}

generator drizzle {
  provider        = "drizzle-prisma-generator"
  previewFeatures = ["multiSchema"]
  output          = "./drizzle" // Where to put generated Drizle tables
  schemas         = ["public"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_CONNECTION_STRING")
  schemas  = ["public", "airfoil"]
}

// Raw events
model investment_flows {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  sender     String // caller of tx
  receiver   String // owner on deposit, could be anyone on withdraw
  owner      String // the one who received or sent the asset
  amount     String
  shares     String
  asset      String
  contract   String
  epoch      Int     @default(0)
  request_id Int     @default(0)
  type       String // deposit | withdraw
  timestamp  Int
  cursor     BigInt? @map("_cursor")

  // The represent the value of investment in the quote asset (from strategy_metadata)
  // updated by trigger on this table using the prices table as info
  // if asset is not empty
  quote_amount Decimal @default(0)

  @@unique([block_number, tx_index, event_index], name: "event_id")
  @@schema("public")
}

model harvests {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  user      String
  contract  String
  amount    String
  price     Float   @default(0) // the indexer will set this 0, but when reading, it will be set to the price at the time of the harvest
  timestamp Int
  cursor    BigInt? @map("_cursor")

  @@unique([block_number, tx_index, event_index], name: "event_id")
  @@schema("public")
}

model position_fees_collected {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  token0  String
  token1  String
  amount0 String
  amount1 String

  vault_address String

  timestamp Int
  cursor    BigInt? @map("_cursor")

  @@unique([block_number, tx_index, event_index], name: "event_id")
  @@schema("public")
}

model position_updated {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  locker          String
  token0          String
  token1          String
  fee             String
  tick_spacing    String
  extension       String
  salt            String
  lower_bound     String
  upper_bound     String
  liquidity_delta String
  amount0         String
  amount1         String

  vault_address String
  user_address  String

  timestamp Int
  cursor    BigInt? @map("_cursor")

  // The represent the value of investment in the quote asset (from strategy_metadata)
  // updated by trigger on this table using the prices table as info
  // if asset is not empty
  quote_amount Decimal @default(0)

  @@unique([block_number, tx_index, event_index], name: "event_id")
  @@schema("public")
}

//
// Shared schemas
// 

model raw_price_events {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  timestamp Int
  source    String
  publisher String
  price     Decimal
  pair_id   String
  volume    Decimal

  @@unique([block_number, tx_index, event_index], name: "event_id")
  @@index([pair_id, timestamp])
  @@index([timestamp, pair_id])
  @@schema("public")
}

// Redemption Router Raw Event Tables
model svk_alt_redemptions_subscribed {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  contract_address String // redemption router address
  new_nft_id       Int
  old_nft_id       Int
  receiver         String
  timestamp        Int
  cursor           BigInt? @map("_cursor")

  @@unique([block_number, tx_index, event_index], name: "event_id")
  @@index([contract_address, old_nft_id])
  @@index([contract_address, new_nft_id])
  @@schema("public")
}

model svk_alt_redemptions_claimed {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  contract_address String // redemption router address
  new_nft_id       Int
  old_nft_id       Int
  receivable       String
  swap_id          Int
  timestamp        Int
  cursor           BigInt? @map("_cursor")

  @@unique([block_number, tx_index, event_index], name: "event_id")
  @@index([contract_address, old_nft_id])
  @@index([contract_address, new_nft_id])
  @@schema("public")
}

model svk_alt_redemptions_unsubscribed {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  contract_address            String // redemption router address
  new_nft_id                  Int
  old_nft_id                  Int
  owner                       String
  is_old_nft_returned         Boolean
  is_original_assets_returned Boolean
  original_assets_returned    String
  timestamp                   Int
  cursor                      BigInt? @map("_cursor")

  @@unique([block_number, tx_index, event_index], name: "event_id")
  @@index([contract_address, old_nft_id])
  @@index([contract_address, new_nft_id])
  @@schema("public")
}

// Post-processed tables

model strategy_metadata {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  strategy_address String
  strategy_name    String
  quote_asset      String

  @@unique([strategy_address], name: "strategy_metadata_id")
  @@schema("public")
}

model prices {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset        String
  price        Float  @default(0)
  timestamp    Int
  block_number Int

  cursor BigInt? @map("_cursor")

  @@unique([asset, timestamp], name: "price_id")
  @@index([asset, block_number])
  @@schema("public")
}

model token_metadata {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address  String
  name     String
  symbol   String
  decimals Int

  pragma_pair_id  String
  pragma_decimals Int

  @@unique([address], name: "token_metadata_id")
  @@schema("public")
}

model lst_price_sync_progress {
  id                   String @id @default("lst_price_sync") @db.Text
  last_processed_block Int?

  @@schema("public")
}

// Post-processed table maintaining final state
model svk_alt_redemptions {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_number Int
  tx_index     Int    @default(0)
  event_index  Int    @default(0)
  tx_hash      String

  contract_address            String // redemption router address
  old_nft_id                  String
  new_nft_id                  String
  receiver                    String?
  owner                       String?
  receivable                  String? // amount claimable
  swap_id                     String?
  is_claimed                  Boolean @default(false)
  is_unsubscribed             Boolean @default(false)
  is_old_nft_returned         Boolean @default(false)
  is_original_assets_returned Boolean @default(false)
  original_assets_returned    String?
  timestamp                   Int
  cursor                      BigInt? @map("_cursor")

  @@unique([contract_address, old_nft_id], name: "redemption_unique")
  @@index([contract_address, new_nft_id])
  @@index([contract_address, is_claimed])
  @@index([contract_address, is_unsubscribed])
  @@schema("public")
}

model strategy_apy {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  strategy_id      String
  strategy_address String
  net_apy          Float? // Made nullable to handle cases where APY cannot be calculated
  timestamp        Int
  block_number     Int?

  @@unique([strategy_id, timestamp], name: "strategy_apy_unique")
  @@index([strategy_id], name: "strategy_apy_strategy_id_idx")
  @@index([timestamp], name: "strategy_apy_timestamp_idx")
  @@schema("public")
}

