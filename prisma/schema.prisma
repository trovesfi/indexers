  block_number        Int
  tx_index            Int
  event_index         Int
  tx_hash             String
  strategy_id         String
  locker              String
  token0              String
  token1              String
  fee                 String
  tick_spacing        String
  extension           String
  swap_amount_signed  String
  is_token1           String
  sqrt_ratio_limit    String
  skip_ahead          String
  delta0_signed       String
  delta1_signed       String
  sqrt_ratio_after    String
  tick_after_signed   String
  liquidity_after     String
  timestamp           Int
  cursor              BigInt? @map("_cursor")

  @@unique([block_number, tx_index, event_index], name: "vesu_ext_ekubo_swap_event_id")
